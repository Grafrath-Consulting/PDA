# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — server-only, never expose to the browser
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# AI key encryption (required for per-user Anthropic keys)
# Any long random string; hashed with SHA-256 to derive the AES-256-GCM key.
# Generate with: openssl rand -hex 32
AI_KEY_ENCRYPTION_SECRET=generated_random_key

# Voyage AI (required for semantic / smart search embeddings)
VOYAGE_API_KEY=your_voyage_api_key
# Optional — defaults to voyage-3-lite
VOYAGE_MODEL=voyage-3-lite

# Google OAuth (optional — only needed for Gmail report sending)
# Must match the client ID/secret configured in Supabase's Google auth provider.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
